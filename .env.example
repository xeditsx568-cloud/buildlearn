# Environment variables — BuildLearn
#
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Required: DATABASE_URL, NEXT_PUBLIC_APP_URL, CLERK_* keys below

# ─── Phase 1 (required) ───────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended)
DATABASE_URL="postgresql://user:pass@localhost:5432/buildlearn"

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Phase 2 — Authentication (Clerk, required) ───────────────────────────

# From Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Auth route URLs (must match src/app/sign-in and sign-up paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-auth redirects (sign-up → /dashboard until onboarding in Phase 4)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Phase 2 — Webhooks (TASK-102, not required for TASK-101) ─────────────

# CLERK_WEBHOOK_SECRET=

# ─── Phase 5 — AI ─────────────────────────────────────────────────────────

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MONTHLY_BUDGET_USD=500

# ─── Post-MVP — Cache / Analytics ─────────────────────────────────────────

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_POSTHOG_KEY=
# SENTRY_DSN=
