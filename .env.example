# Environment variables — BuildLearn
#
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Required: DATABASE_URL, DIRECT_URL, NEXT_PUBLIC_APP_URL, CLERK_* keys below

# ─── Phase 1 (required) ───────────────────────────────────────────────────

# PostgreSQL — Neon (pooled connection for runtime queries)
# Add pgbouncer=true and connect_timeout for Prisma Client + serverless cold starts
DATABASE_URL="postgresql://user:pass@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15"

# PostgreSQL — Neon direct connection for Prisma CLI (migrate, db pull)
# Use the non-pooler hostname; Neon recommends connect_timeout=30 for Prisma
DIRECT_URL="postgresql://user:pass@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Phase 2 — Authentication (Clerk, required) ───────────────────────────

# From Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Auth route URLs (must match src/app/sign-in and sign-up paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-auth redirects — Clerk v7+ force redirect (sign-up → /dashboard until Phase 4)
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# ─── Phase 2 — Webhooks (TASK-102, not required for TASK-101) ─────────────

# CLERK_WEBHOOK_SECRET=

# ─── Phase 5 — AI ─────────────────────────────────────────────────────────

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MONTHLY_BUDGET_USD=500

# ─── Post-MVP — Cache / Analytics ─────────────────────────────────────────

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_POSTHOG_KEY=
# SENTRY_DSN=
