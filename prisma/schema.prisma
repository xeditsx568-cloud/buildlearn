generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExperienceLevel {
  beginner
  some_exposure
  intermediate
}

enum OnboardingStep {
  goal
  experience
  quiz
  path
}

enum LearningPathStatus {
  active
  completed
  paused
}

enum PathGeneratedBy {
  system
  ai
}

enum LearningPathStepType {
  lesson
  challenge
  project_milestone
  mini_project
  review
}

enum LearningPathStepStatus {
  locked
  available
  in_progress
  completed
  skipped
}

model User {
  id            String         @id // Clerk user ID (e.g. user_2abc...)
  email         String         @unique
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(3)
  profile       Profile?
  learningPaths LearningPath[]

  @@map("users")
}

model Profile {
  userId             String           @id @map("user_id")
  displayName        String?          @map("display_name")
  experienceLevel    ExperienceLevel? @map("experience_level")
  learningGoalText   String?          @map("learning_goal_text") @db.Text
  goalSummary        Json?            @map("goal_summary")
  onboardingComplete Boolean          @default(false) @map("onboarding_complete")
  onboardingStep     OnboardingStep?  @map("onboarding_step")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Concept {
  id          String   @id
  name        String
  description String   @db.Text
  domain      String
  difficulty  Int
  tags        String[]

  prerequisites ConceptPrerequisite[] @relation("ConceptPrerequisites")
  dependents    ConceptPrerequisite[] @relation("PrerequisiteConcepts")

  @@map("concepts")
}

model ConceptPrerequisite {
  conceptId      String @map("concept_id")
  prerequisiteId String @map("prerequisite_id")

  concept      Concept @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("PrerequisiteConcepts", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([conceptId, prerequisiteId])
  @@map("concept_prerequisites")
}

model GoalTemplate {
  id               String         @id
  name             String
  matchingKeywords String[]       @map("matching_keywords")
  conceptIds       String[]       @map("concept_ids")
  learningPaths    LearningPath[]

  @@map("goal_templates")
}

model LearningPath {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  goalTemplateId String?            @map("goal_template_id")
  status         LearningPathStatus @default(active)
  generatedBy    PathGeneratedBy    @default(system) @map("generated_by")
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalTemplate   GoalTemplate?      @relation(fields: [goalTemplateId], references: [id], onDelete: SetNull)
  steps          LearningPathStep[]

  @@index([userId, status])
  @@map("learning_paths")
}

model LearningPathStep {
  id          String                 @id @default(uuid())
  pathId      String                 @map("path_id")
  orderIndex  Int                    @map("order_index")
  stepType    LearningPathStepType   @map("step_type")
  referenceId String                 @map("reference_id")
  status      LearningPathStepStatus @default(locked)
  metadata    Json                   @default("{}")
  path        LearningPath           @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, orderIndex])
  @@index([pathId, orderIndex])
  @@map("learning_path_steps")
}

model Lesson {
  id               String @id
  title            String
  content          Json
  estimatedMinutes Int    @map("estimated_minutes")
  version          Int

  @@map("lessons")
}
